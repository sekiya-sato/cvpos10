<Window x:Class="Dmd30CustomerDisplay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CV POS" Width="1280" Height="820" MinWidth="1024" MinHeight="700" WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock FontSize="28" FontWeight="Bold" Text="CV POS" />
                <TextBlock Foreground="DimGray" Text="バーコード読取・会計・売上処理" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right" Orientation="Horizontal">
                <Button Margin="0,0,8,0" Padding="16,8" Command="{Binding ConnectDisplayCommand}" Content="DM-D30 接続" />
                <Button Padding="16,8" Command="{Binding ConnectPrinterCommand}" Content="TM-m30II 接続" />
            </StackPanel>
        </DockPanel>
        <Border Grid.Row="2" Padding="12" Background="#FFF3F6FA" BorderBrush="#FFCBD5E1" BorderThickness="1" CornerRadius="6">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock FontWeight="SemiBold" Text="バーコード" />
                    <TextBox Margin="0,6,0,0" MinHeight="42" FontSize="20" VerticalContentAlignment="Center" Text="{Binding BarcodeText, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding ScanBarcodeCommand}" /></TextBox.InputBindings>
                    </TextBox>
                </StackPanel>
                <Button Grid.Column="2" Width="132" Margin="0,25,0,0" Padding="12,8" Command="{Binding ScanBarcodeCommand}" Content="読取" />
            </Grid>
        </Border>
        <DataGrid Grid.Row="4" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True" ItemsSource="{Binding CartLines}" SelectedItem="{Binding SelectedLine}">
            <DataGrid.Columns>
                <DataGridTextColumn Width="70" Header="No." Binding="{Binding LineNo}" />
                <DataGridTextColumn Width="150" Header="バーコード" Binding="{Binding Barcode}" />
                <DataGridTextColumn Width="*" Header="商品名" Binding="{Binding Name}" />
                <DataGridTextColumn Width="100" Header="単価" Binding="{Binding UnitPrice, StringFormat={}{0:N0}}" />
                <DataGridTextColumn Width="90" Header="点数" Binding="{Binding Quantity, StringFormat={}{0:N0}}" />
                <DataGridTextColumn Width="130" Header="明細金額" Binding="{Binding Amount, StringFormat={}{0:N0}}" />
            </DataGrid.Columns>
        </DataGrid>
        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="360" /></Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Foreground="DimGray" Text="{Binding StatusMessage}" TextWrapping="Wrap" />
            <Border Grid.Column="2" Padding="14" Background="#FF1E293B" CornerRadius="8">
                <StackPanel>
                    <TextBlock Foreground="White" FontSize="18" FontWeight="SemiBold" Text="合計" />
                    <TextBlock Margin="0,4,0,0" Foreground="White" FontSize="24" Text="{Binding TotalQuantity, StringFormat=合計点数 {0:N0}点}" />
                    <TextBlock Foreground="White" FontSize="30" FontWeight="Bold" Text="{Binding TotalAmount, StringFormat=合計金額 {0:N0}円}" />
                    <Button Margin="0,12,0,0" Padding="16,10" Background="#FF16A34A" Foreground="White" FontSize="18" Command="{Binding StartCheckoutCommand}" Content="会計" />
                </StackPanel>
            </Border>
        </Grid>
        <Border Grid.RowSpan="7" Padding="28" Background="#AA0F172A" Visibility="{Binding IsCheckoutMode, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Width="560" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center" Background="White" CornerRadius="10">
                <StackPanel>
                    <TextBlock FontSize="24" FontWeight="Bold" Text="会計" />
                    <TextBlock Margin="0,8,0,16" FontSize="20" Text="{Binding TotalAmount, StringFormat=ご請求額 {0:N0}円}" />
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="10" /><RowDefinition Height="Auto" /><RowDefinition Height="10" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Text="現金" /><TextBox Grid.Column="1" MinHeight="38" FontSize="18" HorizontalContentAlignment="Right" Text="{Binding CashAmount, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="カード" /><TextBox Grid.Row="2" Grid.Column="1" MinHeight="38" FontSize="18" HorizontalContentAlignment="Right" Text="{Binding CardAmount, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Row="4" VerticalAlignment="Center" Text="その他金種" /><TextBox Grid.Row="4" Grid.Column="1" MinHeight="38" FontSize="18" HorizontalContentAlignment="Right" Text="{Binding OtherAmount, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                    <Separator Margin="0,18" />
                    <TextBlock FontSize="20" FontWeight="Bold" Text="{Binding ChangeAmount, StringFormat=お釣り {0:N0}円}" />
                    <StackPanel Margin="0,20,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button Margin="0,0,10,0" Padding="18,8" Command="{Binding CancelCheckoutCommand}" Content="戻る" />
                        <Button Padding="18,8" Background="#FF2563EB" Foreground="White" Command="{Binding CompleteCheckoutCommand}" Content="売上確定・印字" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
