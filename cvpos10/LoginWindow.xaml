<Window x:Class="Dmd30CustomerDisplay.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CV POS ログイン" Width="460" Height="330" ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
    <Grid Margin="32">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="16" /><RowDefinition Height="Auto" /><RowDefinition Height="10" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <TextBlock FontSize="24" FontWeight="Bold" Text="CV POS LOGIN" />
        <StackPanel Grid.Row="2">
            <TextBlock Text="ログインID" />
            <TextBox Margin="0,6,0,0" MinHeight="36" Text="{Binding LoginId, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>
        <StackPanel Grid.Row="4">
            <TextBlock Text="パスワード" />
            <PasswordBox x:Name="PasswordBox" Margin="0,6,0,0" MinHeight="36" PasswordChanged="PasswordBox_PasswordChanged" />
        </StackPanel>
        <TextBlock Grid.Row="5" Margin="0,16,0,0" Foreground="DimGray" Text="{Binding StatusMessage}" TextWrapping="Wrap" />
        <StackPanel Grid.Row="6" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button Margin="0,0,10,0" Padding="16,8" IsCancel="True" Content="キャンセル" />
            <Button Padding="16,8" IsDefault="True" Command="{Binding LoginCommand}" Content="ログイン" />
        </StackPanel>
    </Grid>
</Window>
